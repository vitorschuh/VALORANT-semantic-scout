# Loaded by `astro dev start` into the Airflow containers (and by the override compose services)
ICEBERG_CATALOG_URI=http://iceberg-rest:8181
ICEBERG_S3_ENDPOINT=http://minio:9000
ICEBERG_WAREHOUSE=s3://warehouse/
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
AWS_REGION=us-east-1
SERVING_DB_DSN=postgresql://valorant:valorant@serving-db:5432/serving
OPENAI_API_KEY=
# Must match the embedding model (phase 4). Changing it requires recreating the serving-db volume.
EMBEDDING_DIM=1536
